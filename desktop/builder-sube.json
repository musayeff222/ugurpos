{
  "appId": "az.cigkofte.ugurpos.sube",
  "productName": "UgurPOS Sube",
  "copyright": "İstanbul Çiğköfte",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "offline.html",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "app",
      "to": "app"
    }
  ],
  "extraMetadata": {
    "version": "1.0.0",
    "description": "UgurPOS şube girişi",
    "ugurposProfile": {
      "startPath": "/login/sube",
      "title": "UgurPOS Sube",
      "fullscreen": true
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "UgurPOS Sube",
    "artifactName": "UgurPOS-Sube-Setup-${version}.exe"
  }
}
