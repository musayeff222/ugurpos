{
    "name": "ugurpos-kassir",
    "version": "1.2.0",
    "private": true,
    "author": "İstanbul Çiğköfte",
    "description": "UgurPOS Kassir — internetsiz satış, internet gələndə serverə yüklənir",
    "main": "main.cjs",
    "scripts": {
      "prepare-app": "node prepare-app.cjs",
      "start": "node prepare-app.cjs && electron .",
      "dist": "node prepare-app.cjs && electron-builder --win nsis",
      "dist:sube": "node prepare-app.cjs && electron-builder --win nsis --config builder-sube.json",
      "dist:admin": "node prepare-app.cjs && electron-builder --win nsis --config builder-admin.json",
      "dist:istesalat": "node prepare-app.cjs && electron-builder --win nsis --config builder-istesalat.json"
    },
  "devDependencies": {
    "electron": "^36.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "az.cigkofte.ugurpos.kassir",
    "productName": "UgurPOS Kassir",
    "copyright": "İstanbul Çiğköfte",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UgurPOS Kassir",
      "artifactName": "UgurPOS-Kassir-Setup-${version}.exe"
    }
  }
}
